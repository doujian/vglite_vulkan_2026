#version 450
/* Unified tiled upload compute shader.
 *
 * Copies packed pixel data into a TILED (OPTIMAL) destination image:
 *   - Source: texel buffer (usamplerBuffer) whose VkBufferView format is
 *     R32_UINT / R16_UINT / R8_UINT by bytes-per-pixel. texelFetch uses
 *     the dedicated sampling fetch path and returns each pixel's raw
 *     bytes zero-extended in .x -- no ALU byte twiddling in the shader.
 *   - Destination: FORMATLESS uimage2D storage view (requires
 *     shaderStorageImageWriteWithoutFormat), raw bit pattern written
 *     via imageStore; format interpretation is left to the sampling
 *     views, which use the original vg_lite format (image created as
 *     R16_UINT for packed 16bpp so STORAGE support is available).
 *
 * Source texels are laid out tightly: texel index = y * width + x,
 * one texel per pixel (bpp bytes each), no row padding.
 *
 * Bindings:
 *   0 - uniform texel buffer (usamplerBuffer), *_UINT format by bpp
 *   1 - writeonly uimage2D (no format qualifier), GENERAL layout
 *
 * Push constants (8 bytes):
 *   width, height       - image dimensions in pixels
 */
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform usamplerBuffer srcTexels;

layout(binding = 1) writeonly uniform uimage2D dstImage;

layout(push_constant) uniform PushParams {
    uint width;
    uint height;
} p;

void main()
{
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    if (x >= p.width || y >= p.height)
        return;

    /* Raw pixel bytes fetched by the texel fetch unit, zero-extended. */
    uvec4 v = texelFetch(srcTexels, int(y * p.width + x));
    imageStore(dstImage, ivec2(int(x), int(y)), v);
}
